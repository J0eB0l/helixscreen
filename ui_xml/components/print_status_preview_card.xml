<!--
  Print Status preview card - the art band and everything that stacks over it.

  ONE definition for both orientations; the host passes the sizing at the
  instance site and nothing else.

  Layout: flex column with preview_stack (flex_grow) above and metadata_clip
  (content-sized) below. The split is COMPUTED, not reserved - the strip has two
  stable heights (it gains a text_small line + space_xs when Klipper publishes an
  M117), so no constant is correct. pad_gap=0 keeps the strip flush against the
  art; ui_card's create handler defaults pad_gap to space_md. Every other child
  is absolutely aligned over the card and carries ignore_layout="true" so the
  column does not reflow it. Progress, times and the pre-print state live in
  the panel's strip and the job tile's checklist, not here.
-->
<component>
  <view name="thumbnail_section"
        extends="ui_card" style_pad_all="0" style_radius="#border_radius" style_clip_corner="true" flex_flow="column"
        style_pad_gap="0">

    <!-- The art band: whatever the column leaves above the strip. -->
    <preview_stack name="preview_clear_area"
                   width="100%" flex_grow="1" gradient_name="gradient_background" viewer_name="print_gcode_viewer"
                   thumbnail_name="print_thumbnail" hint_name="rotate_hint" gradient_hidden="exclude_map_active eq 1"
                   viewer_hidden="gcode_viewer_mode eq 0"
                   thumbnail_hidden="gcode_viewer_mode gt 0 or exclude_map_active eq 1"
                   hint_hidden="gcode_viewer_mode ne 1"/>

    <!-- Corner controls over the art: the skip-objects button (multi-object
         prints only) and the view-mode toggle. The row lays them out, so a
         hidden objects button gives its slot back to the toggle. The row
         itself takes no taps; drags on bare art reach the viewer below. -->
    <lv_obj name="preview_corner_buttons"
            width="content" height="content" ignore_layout="true" align="top_left" style_translate_x="#space_md"
            style_translate_y="#space_md" flex_flow="row" style_pad_all="0" style_pad_gap="#space_md" style_bg_opa="0"
            style_border_width="0" clickable="false" scrollable="false">
      <!-- Skip-objects button, visible only for a multi-object print -->
      <exclude_objects_button name="btn_objects"
                              callback="on_print_status_objects" hidden_when="exclude_objects_available eq 0"/>

      <!-- View mode toggle: switches between progress (ghost layers) and complete view -->
      <lv_obj name="btn_view_toggle"
              width="#icon_button_size_lg" height="#icon_button_size_lg" style_bg_color="#card_bg" style_bg_opa="180"
              style_radius="#icon_button_radius_lg" clickable="true" style_pad_all="0" scrollable="false">
        <style name="styles.press_wash" selector="pressed"/>
        <bind_flag_if_eq subject="gcode_viewer_mode" flag="hidden" ref_value="0"/>
        <lv_label name="btn_view_toggle_icon"
                  bind_text="view_toggle_icon" style_text_font="mdi_icons_24" style_text_color="#text_muted"
                  align="center"/>
        <event_cb trigger="clicked" callback="on_view_toggle"/>
      </lv_obj>
    </lv_obj>

    <!-- PRINT COMPLETE OVERLAY: Shown when print finishes successfully -->
    <!-- Single derived subject show_complete_overlay = (outcome==COMPLETE && !dismissed). -->
    <!-- Two independent bind_flag observers on hidden raced at startup (L042). -->
    <lv_obj name="print_complete_overlay"
            width="100%" height="100%" ignore_layout="true" align="top_mid" style_radius="0" style_pad_all="#space_lg"
            style_pad_bottom="#metadata_clip_height" flex_flow="column" style_flex_main_place="center"
            style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_sm" scrollable="false"
            clickable="true" hidden="true">
      <bind_flag_if_eq subject="show_complete_overlay" flag="hidden" ref_value="0"/>
      <event_cb trigger="clicked" callback="on_print_status_dismiss_overlay"/>
      <!-- Green success badge with checkmark (animated on appearance) -->
      <!-- Uses ui_button for auto-contrast text via update_button_text_contrast() -->
      <ui_button name="success_badge"
                 width="content" height="content" variant="success" icon="check_circle" text="Print Complete!"
                 clickable="false" focusable="false" style_radius="#space_lg" style_pad_left="#space_md"
                 style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm"/>
    </lv_obj>

    <!-- PRINT CANCELLED OVERLAY: shown via show_cancelled_overlay (see COMPLETE above). -->
    <lv_obj name="print_cancelled_overlay"
            width="100%" height="100%" ignore_layout="true" align="top_mid" style_radius="0" style_pad_all="#space_lg"
            style_pad_bottom="#metadata_clip_height" flex_flow="column" style_flex_main_place="center"
            style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_sm" scrollable="false"
            clickable="true" hidden="true">
      <bind_flag_if_eq subject="show_cancelled_overlay" flag="hidden" ref_value="0"/>
      <event_cb trigger="clicked" callback="on_print_status_dismiss_overlay"/>
      <!-- Orange warning badge with cancel icon (animated on appearance) -->
      <!-- Uses ui_button for auto-contrast text via update_button_text_contrast() -->
      <ui_button name="cancel_badge"
                 width="content" height="content" variant="warning" icon="cancel" text="Print Canceled"
                 clickable="false" focusable="false" style_radius="#space_lg" style_pad_left="#space_md"
                 style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm"/>
    </lv_obj>

    <!-- PRINT ERROR OVERLAY: shown via show_error_overlay (see COMPLETE above). -->
    <lv_obj name="print_error_overlay"
            width="100%" height="100%" ignore_layout="true" align="top_mid" style_radius="0" style_pad_all="#space_lg"
            style_pad_bottom="#metadata_clip_height" flex_flow="column" style_flex_main_place="center"
            style_flex_cross_place="center" style_flex_track_place="center" style_pad_gap="#space_sm" scrollable="false"
            clickable="true" hidden="true">
      <bind_flag_if_eq subject="show_error_overlay" flag="hidden" ref_value="0"/>
      <event_cb trigger="clicked" callback="on_print_status_dismiss_overlay"/>
      <!-- Red danger badge with alert icon (animated on appearance) -->
      <!-- Uses ui_button for auto-contrast text via update_button_text_contrast() -->
      <ui_button name="error_badge"
                 width="content" height="content" variant="danger" icon="alert_circle" text="Print Failed"
                 clickable="false" focusable="false" style_radius="#space_lg" style_pad_left="#space_md"
                 style_pad_right="#space_md" style_pad_top="#space_sm" style_pad_bottom="#space_sm"/>
    </lv_obj>

    <!-- PRINT PAUSED OVERLAY: shown while print is in PAUSED state. Driven by   -->
    <!-- show_paused_overlay (1 when print_state_enum==PAUSED). Unlike the three -->
    <!-- terminal overlays above, this is NOT dismissible — the badge stays up  -->
    <!-- until the print resumes or terminates, so the paused condition is      -->
    <!-- always visually obvious. Resume/Cancel controls live in the strip.    -->
    <!-- Title is static; reason is an optional second label hidden when         -->
    <!-- print_pause_reason_visible == 0 (set by recompute_paused_overlay_*).    -->
    <lv_obj name="print_paused_overlay"
            width="100%" height="100%" ignore_layout="true" align="top_mid" style_radius="0" style_pad_all="#space_lg"
            style_pad_bottom="#metadata_clip_height" flex_flow="column" style_flex_main_place="center"
            style_flex_cross_place="center" style_flex_track_place="center" scrollable="false" clickable="false"
            hidden="true">
      <bind_flag_if_eq subject="show_paused_overlay" flag="hidden" ref_value="0"/>
      <!-- ui_button styled container (variant="primary" applies bg + auto-contrast on  -->
      <!-- child labels). Two stacked labels inside: a title that's always shown and a  -->
      <!-- reason that's hidden when print_pause_reason_visible==0. Toggling visibility  -->
      <!-- of an independent widget makes the parent flex-column grow declaratively —    -->
      <!-- avoiding the dynamic LV_SIZE_CONTENT cascade issue we hit with a single       -->
      <!-- multi-line label that changes line count after the badge was already laid out.-->
      <ui_button name="paused_badge"
                 width="content" height="content" variant="primary" layout="row" style_min_height="0" clickable="false"
                 focusable="false" style_radius="#space_lg" style_pad_left="#space_md" style_pad_right="#space_md"
                 style_pad_top="#space_sm" style_pad_bottom="#space_sm" style_pad_gap="#space_sm">
        <lv_label text="#icon_pause" style_text_font="mdi_icons_24"/>
        <lv_obj width="content"
                height="content" style_pad_all="0" style_pad_gap="0" style_border_width="0" style_bg_opa="0"
                flex_flow="column" style_flex_cross_place="center" scrollable="false">
          <lv_label text="Print Paused" style_text_align="center"/>
          <lv_label name="paused_badge_reason" bind_text="print_pause_reason" style_text_align="center">
            <bind_flag_if_eq subject="print_pause_reason_visible" flag="hidden" ref_value="0"/>
          </lv_label>
        </lv_obj>
      </ui_button>
    </lv_obj>

    <!-- Metadata strip - the second (content-sized) child of thumbnail_section's
         flex column, sitting flush under preview_clear_area. Grows when the
         optional M117 (display_message) row becomes visible; the column hands
         the difference straight back to the preview above. -->
    <lv_obj name="metadata_clip" width="100%" height="content" style_radius="0" style_pad_all="0" scrollable="false">
      <!-- Inner overlay with semi-transparent background and rounded corners -->
      <lv_obj name="metadata_overlay"
              width="100%" height="content" align="bottom_mid" style_pad_top="#space_md" style_pad_bottom="#space_md"
              flex_flow="column" scrollable="false">
        <!-- Translucency, radius, side padding and row gap come from the shared
             style so this strip and the file detail view's cannot drift apart. -->
        <style name="styles.metadata_strip"/>
        <!-- Layer / objects / filament as icon clusters, not prose. The prose
             row ("Layer 474 / 1334 (55.4mm)" + "12 of 12 objects" + "92.6m
             used") measured 393px in the 363px strip an 800x480 panel
             produces, and its width changes with every translation of
             Layer/of/objects/used; icons carry the words and the bound
             strings are bare numbers, so the row is language-neutral and
             fits every tier. The layer cluster grows and dots as the floor:
             a pathological count degrades instead of overlapping
             (space_between derives its gap as (row - content) / (n-1) with
             no floor at zero - lv_flex.c place_content). -->
        <lv_obj width="100%"
                height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="start"
                style_flex_cross_place="center" style_pad_gap="#space_sm" scrollable="false">
          <!-- On printers with the layer-pause macros, a tap during a print
               opens the Pause at Layer modal (layer_pause_modal.xml): a muted
               pause glyph marks it as tappable, and turns into the pending
               layer number while a pause is scheduled. -->
          <lv_obj name="layer_cluster"
                  height="content" flex_grow="1" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_xs" scrollable="false" clickable="false" style_radius="#border_radius">
            <style name="styles.press_wash" selector="pressed"/>
            <bind_flag_if cond="printer_has_layer_pause and layer_pause_availability gt 0" flag="clickable"/>
            <event_cb trigger="clicked" callback="on_layer_pause_open"/>
            <icon name="layer_icon" src="layers" size="xs" variant="secondary" clickable="false" event_bubble="true"/>
            <text_small name="layer_progress_label"
                        text="0 / 0" bind_text="print_layer_text" style_text_align="left" flex_grow="1" long_mode="dots"
                        event_bubble="true"/>
            <icon name="layer_pause_hint"
                  src="pause" size="xs" variant="muted" clickable="false" event_bubble="true" hidden="true">
              <bind_flag_if cond="printer_has_layer_pause and layer_pause_availability gt 0 and layer_pause_layer eq 0"
                            flag="hidden" invert="true"/>
            </icon>
            <lv_obj name="layer_pause_chip"
                    width="content" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                    style_pad_gap="#space_xxs" scrollable="false" clickable="false" event_bubble="true" hidden="true">
              <bind_flag_if cond="printer_has_layer_pause and layer_pause_layer gt 0" flag="hidden" invert="true"/>
              <icon src="pause" size="xs" variant="warning" clickable="false" event_bubble="true"/>
              <text_small name="layer_pause_chip_label"
                          bind_text="layer_pause_layer" style_text_color="#warning" event_bubble="true"/>
            </lv_obj>
          </lv_obj>
          <lv_obj name="objects_cluster"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_xs" scrollable="false">
            <bind_flag_if_eq subject="exclude_objects_available" flag="hidden" ref_value="0"/>
            <icon name="objects_icon" src="cube_outline" size="xs" variant="secondary" clickable="false"/>
            <text_small name="objects_count_label" text="" bind_text="print_objects_text"/>
          </lv_obj>
          <lv_obj name="filament_cluster"
                  height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                  style_pad_gap="#space_xs" scrollable="false">
            <icon name="filament_icon" src="filament" size="xs" variant="secondary" clickable="false"/>
            <text_small name="filament_used_label" text="" bind_text="print_filament_used_text"/>
          </lv_obj>
        </lv_obj>
        <!-- File Name (shared subject from ActivePrintMediaManager) -->
        <text_body name="file_name"
                   width="100%" text="benchy.gcode" bind_text="print_display_filename" style_text_align="left"
                   long_mode="scroll_circular"/>
        <!-- Klipper display_status.message (M117) — collapses to zero height -->
        <!-- when empty. -->
        <text_small name="display_message"
                    width="100%" bind_text="display_message" style_text_align="left" long_mode="scroll_circular"
                    style_text_color="#text_muted" hidden="true">
          <bind_flag_if_eq subject="display_message_visible" flag="hidden" ref_value="0"/>
        </text_small>
      </lv_obj>
      <!-- metadata_overlay -->
    </lv_obj>
    <!-- metadata_clip -->

  </view>
</component>
